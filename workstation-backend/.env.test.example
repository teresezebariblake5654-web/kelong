NODE_ENV=test
PORT=3001
APP_BASE_URL=http://localhost:3001
WEB_BASE_URL=http://localhost:5173

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/agent_workstation?schema=public"
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/agent_workstation?schema=public"
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_CONNECTION_LIMIT=5
DB_CONNECT_TIMEOUT_MS=5000
DB_POOL_TIMEOUT_MS=10000

JWT_ACCESS_SECRET=test-only-jwt-access-secret-32chars
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=14
BCRYPT_ROUNDS=10
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
REFRESH_COOKIE_NAME=refresh_token
CORS_ORIGINS=http://localhost:5173
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=1000
DEMO_USER_PASSWORD=DemoPass123!

MODEL_PROVIDER=mock
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
AI_MAX_INPUT_BYTES=65536
AI_MAX_OUTPUT_TOKENS=2048
UPLOAD_DIR=uploads
DEFAULT_USER_CREDITS=1000
DEVICE_BINDING_LIMIT=2
LICENSE_TOKEN_SECRET=test-license-token-secret-at-least-32-characters
LICENSE_TOKEN_TTL=15m
LICENSE_HASH_PEPPER=test-license-hash-pepper-at-least-32-characters

DEFAULT_PAYMENT_PROVIDER=mock
MOCK_PAYMENT_SECRET=test-mock-payment-secret
WECHAT_PAY_ENABLED=false
ALIPAY_ENABLED=false

# Isolated LobsterAI lead-discovery job queue Redis (tests mock the queue).
LEAD_QUEUE_REDIS_HOST=127.0.0.1
LEAD_QUEUE_REDIS_PORT=6379
LEAD_QUEUE_REDIS_USERNAME=
LEAD_QUEUE_REDIS_PASSWORD=
LEAD_QUEUE_REDIS_DB=0
LEAD_DISCOVERY_QUEUE_NAME=lead-discovery
LEAD_DISCOVERY_WORKER_CONCURRENCY=1
