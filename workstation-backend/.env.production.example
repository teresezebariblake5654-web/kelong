# Production template — copy to .env on the server (do NOT commit secrets)
# Target inventory (2026-08): Lighthouse Ubuntu-O2mi @ 106.54.15.76 (Shanghai)
# DNS: @ / www / api → 106.54.15.76 | No Tencent RDS — use Postgres on the same box
NODE_ENV=production
HOST=127.0.0.1
PORT=3001
RATE_LIMIT_ENABLED=true
LLM_REQUEST_TIMEOUT_MS=90000
SIGNUP_BONUS_CREDITS_MAX=50000
CHAT_RATE_LIMIT_MAX=30
AI_CONCURRENCY_LIMIT=2
FEEDBACK_RATE_LIMIT_MAX=5
UPLOAD_RATE_LIMIT_MAX=10
APP_BASE_URL=https://api.bx-aigc.com
WEB_BASE_URL=https://bx-aigc.com

# Postgres on the same Lighthouse (127.0.0.1). If you later buy RDS, switch host + DB_SSL=true.
DATABASE_URL="postgresql://aw:STRONG_PASSWORD@127.0.0.1:5432/agent_workstation?schema=public"
DIRECT_DATABASE_URL="postgresql://aw:STRONG_PASSWORD@127.0.0.1:5432/agent_workstation?schema=public"
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_CONNECTION_LIMIT=20
DB_CONNECT_TIMEOUT_MS=5000
DB_POOL_TIMEOUT_MS=10000

# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=replace-with-long-random-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=14
BCRYPT_ROUNDS=12
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=.bx-aigc.com
REFRESH_COOKIE_NAME=refresh_token
CORS_ORIGINS=https://bx-aigc.com,https://www.bx-aigc.com
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=10
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX=60

# Production hard rules (boot fails if violated):
# - MODEL_PROVIDER must NOT be mock
# - MAIL_PROVIDER must NOT be mock
# - DEFAULT_PAYMENT_PROVIDER must NOT be mock
# - ALLOW_DEMO_USER=false
# - LICENSE_ENFORCEMENT_ENABLED=true
# - CORS_ORIGINS must not include *
ALLOW_DEMO_USER=false
LICENSE_ENFORCEMENT_ENABLED=true
DEMO_USER_PASSWORD=change-me-unused-in-prod

# Admin seed (set BEFORE first `npx prisma db seed`)
ADMIN_SEED_EMAIL=admin@bx-aigc.com
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_PASSWORD=replace-with-strong-admin-password

# Real LLM (1701) — do not use mock
MODEL_PROVIDER=custom
AI_PROVIDER=custom
LLM_API_KEY=replace-with-real-1701-api-key
LLM_BASE_URL=https://1701.store/v1
LLM_MODEL=gpt-5.6-sol
AI_MAX_INPUT_BYTES=65536
AI_MAX_OUTPUT_TOKENS=2048
UPLOAD_DIR=uploads
DEFAULT_USER_CREDITS=0
# Review economics before go-live (dev default was 10000)
SIGNUP_BONUS_CREDITS=20000
DEVICE_BINDING_LIMIT=2
LICENSE_TOKEN_SECRET=replace-with-separate-license-secret-at-least-32-chars
LICENSE_TOKEN_TTL=15m
LICENSE_HASH_PEPPER=replace-with-license-hash-pepper-at-least-32-chars

# Phase-1 payments: manual scan QR + admin confirm (SDK wechat/alipay are stubs)
DEFAULT_PAYMENT_PROVIDER=manual
MOCK_PAYMENT_SECRET=unused-in-prod-min-16-chars
WECHAT_PAY_ENABLED=false
ALIPAY_ENABLED=false
PAYMENT_ALIPAY_QR_URL=https://api.bx-aigc.com/static/payment/alipay-qr-50.png
PAYMENT_ALIPAY_QR_URL_50=https://api.bx-aigc.com/static/payment/alipay-qr-50.png
PAYMENT_ALIPAY_QR_URL_100=https://api.bx-aigc.com/static/payment/alipay-qr-100.png
PAYMENT_ALIPAY_QR_URL_500=https://api.bx-aigc.com/static/payment/alipay-qr-500.png
PAYMENT_WECHAT_QR_URL=https://api.bx-aigc.com/static/payment/wechat-qr-50.png
PAYMENT_WECHAT_QR_URL_50=https://api.bx-aigc.com/static/payment/wechat-qr-50.png
PAYMENT_WECHAT_QR_URL_100=https://api.bx-aigc.com/static/payment/wechat-qr-100.png
PAYMENT_WECHAT_QR_URL_500=https://api.bx-aigc.com/static/payment/wechat-qr-500.png
PAYMENT_PAYEE_NAME=扫码收款
PAYMENT_SUPPORT_TEXT=扫码付款后点「我已付款」，积分立刻到账
PAYMENT_NOTICE=付款时可备注订单号，到账更快

# OTP mail — Tencent Cloud SES template API (recommended) or SMTP
# See docs/tencent-email-otp-setup.md
MAIL_PROVIDER=ses-api
SMTP_HOST=smtp.qcloudmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@bx-aigc.com
SMTP_PASS=replace-with-ses-smtp-pass
MAIL_FROM=noreply@bx-aigc.com
MAIL_FROM_NAME=Workhorse AI
TENCENT_SECRET_ID=replace-with-cam-secret-id
TENCENT_SECRET_KEY=replace-with-cam-secret-key
TENCENT_SES_REGION=ap-guangzhou
TENCENT_SES_OTP_TEMPLATE_ID=0
EMAIL_OTP_TTL_SEC=300
EMAIL_OTP_RESEND_COOLDOWN_SEC=60
EMAIL_OTP_DAILY_LIMIT=10

# In-app feedback inbox (server-only; never exposed to UI)
FEEDBACK_INBOX_EMAIL=jq202604@126.com
FEEDBACK_SMTP_HOST=smtp.126.com
FEEDBACK_SMTP_PORT=465
FEEDBACK_SMTP_SECURE=true
FEEDBACK_SMTP_USER=jq202604@126.com
FEEDBACK_SMTP_PASS=replace-with-126-smtp-auth-code
FEEDBACK_SMTP_FROM=jq202604@126.com
