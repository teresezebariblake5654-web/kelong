PORT=3001
HOST=0.0.0.0
NODE_ENV=development
# development/test may use HOST=0.0.0.0; production is forced to 127.0.0.1
RATE_LIMIT_ENABLED=false
LLM_REQUEST_TIMEOUT_MS=90000
SIGNUP_BONUS_CREDITS_MAX=50000
CHAT_RATE_LIMIT_MAX=30
AI_CONCURRENCY_LIMIT=2
FEEDBACK_RATE_LIMIT_MAX=5
UPLOAD_RATE_LIMIT_MAX=10
APP_BASE_URL=http://localhost:3001
WEB_BASE_URL=http://localhost:5173

# Database (local Docker / Embedded PostgreSQL — NEVER commit real RDS credentials)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/agent_workstation?schema=public"
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/agent_workstation?schema=public"
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_CONNECTION_LIMIT=10
DB_CONNECT_TIMEOUT_MS=5000
DB_POOL_TIMEOUT_MS=10000

# Lead discovery dry-run (HTTP providers only — never commit real KeeLead keys)
SEARXNG_BASE_URL=http://127.0.0.1:8080
SEARXNG_TIMEOUT_MS=15000
KEELEAD_BASE_URL=http://127.0.0.1:3010
KEELEAD_PROVIDER_KEY=
KEELEAD_TIMEOUT_MS=15000
# Firecrawl: set to your running API base (self-host docker-compose default host map is often :3002).
# Leave empty until confirmed. Scrape path used by backend: POST {FIRECRAWL_BASE_URL}/v1/scrape
FIRECRAWL_BASE_URL=
FIRECRAWL_API_KEY=
FIRECRAWL_TIMEOUT_MS=60000

# Auth
JWT_ACCESS_SECRET=replace-with-at-least-32-chars-secret
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=14
BCRYPT_ROUNDS=12
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=
REFRESH_COOKIE_NAME=refresh_token
CORS_ORIGINS=http://localhost:5175,http://127.0.0.1:5175,http://localhost:5174,http://localhost:5173,http://127.0.0.1:5174
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=20
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX=120
ALLOW_DEMO_USER=true
DEMO_USER_PASSWORD=DemoPass123!
# Seed 管理员（充值确认 /admin）。生产务必改密码后再 prisma db seed
ADMIN_SEED_EMAIL=admin@bx-aigc.com
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_PASSWORD=AdminPass123!

# ---------------------------------------------------------------------------
# AI：通用 OpenAI Chat Completions 兼容接入（上游供应商，如 1701 New API）
# 生产必须：
#   MODEL_PROVIDER=custom
#   LLM_BASE_URL=https://1701.store/v1
#   LLM_API_KEY=sk-xxx   （仅后端，禁止写入前端 / 日志 / DB）
# App 用户额度仍在本地 PostgreSQL（CreditAccount），与 1701 平台额度分离。
# ---------------------------------------------------------------------------
AI_PROVIDER=mock
MODEL_PROVIDER=mock
LICENSE_ENFORCEMENT_ENABLED=false

LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# 生产 / 联调 1701 示例：
# MODEL_PROVIDER=custom
# LLM_BASE_URL=https://1701.store/v1
# LLM_API_KEY=sk-xxx
# LLM_MODEL=your-model-name

# 兼容旧变量（MODEL_PROVIDER=openai / deepseek 时可用）
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 示例：
# MODEL_PROVIDER=openai
# LLM_API_KEY=sk-xxx
# LLM_MODEL=gpt-4o-mini
#
# MODEL_PROVIDER=deepseek
# LLM_API_KEY=sk-xxx
# LLM_MODEL=deepseek-chat
#
# MODEL_PROVIDER=qwen
# LLM_API_KEY=sk-xxx
# LLM_MODEL=qwen-plus
#
# MODEL_PROVIDER=moonshot
# LLM_API_KEY=sk-xxx
# LLM_MODEL=moonshot-v1-8k
#
# MODEL_PROVIDER=zhipu
# LLM_API_KEY=xxx.xxx
# LLM_MODEL=glm-4-flash
#
# MODEL_PROVIDER=siliconflow
# LLM_API_KEY=sk-xxx
# LLM_MODEL=deepseek-ai/DeepSeek-V3
#
# MODEL_PROVIDER=custom
# LLM_API_KEY=sk-xxx
# LLM_BASE_URL=https://your-gateway.example/v1
# LLM_MODEL=your-model-name

AI_MAX_INPUT_BYTES=65536
AI_MAX_OUTPUT_TOKENS=2048
# App 额度计费（产品内部额度，≠ Token / 1701 余额；约 1000 额度 ≈ ¥1）
AI_INPUT_CREDIT_PER_1K_TOKENS=30
AI_OUTPUT_CREDIT_PER_1K_TOKENS=120
AI_CHAT_MULTIPLIER=1
AI_CHAT_MIN_CREDIT_COST=20
AI_AGENT_MULTIPLIER=2
AI_AGENT_MIN_CREDIT_COST=300
AI_AGENT_MAX_CREDIT_PER_RUN=20000
AI_AGENT_MAX_STEPS=8
AI_WORKFLOW_MULTIPLIER=2.5
AI_WORKFLOW_MIN_CREDIT_COST=500
CREDIT_LOW_BALANCE_THRESHOLD=5000
SIGNUP_BONUS_CREDITS=20000
CREDIT_DISPLAY_NAME=AI积分
UPLOAD_DIR=uploads
DEFAULT_USER_CREDITS=1000
DEVICE_BINDING_LIMIT=2
LICENSE_TOKEN_SECRET=replace-with-separate-license-secret-at-least-32-chars
LICENSE_TOKEN_TTL=15m
LICENSE_HASH_PEPPER=replace-with-license-hash-pepper-at-least-32-chars

# Payments
# mock=本地开发；生产请用 manual（扫码人工确认）。wechat/alipay SDK 未接好前不要开。
DEFAULT_PAYMENT_PROVIDER=mock
MOCK_PAYMENT_SECRET=dev-mock-payment-secret-change-me
WECHAT_PAY_ENABLED=false
ALIPAY_ENABLED=false
PAYMENT_WECHAT_QR_URL=http://127.0.0.1:3001/static/payment/wechat-qr-50.png
PAYMENT_WECHAT_QR_URL_50=http://127.0.0.1:3001/static/payment/wechat-qr-50.png
PAYMENT_WECHAT_QR_URL_100=http://127.0.0.1:3001/static/payment/wechat-qr-100.png
PAYMENT_WECHAT_QR_URL_500=http://127.0.0.1:3001/static/payment/wechat-qr-500.png
PAYMENT_ALIPAY_QR_URL=http://127.0.0.1:3001/static/payment/alipay-qr-50.png
PAYMENT_ALIPAY_QR_URL_50=http://127.0.0.1:3001/static/payment/alipay-qr-50.png
PAYMENT_ALIPAY_QR_URL_100=http://127.0.0.1:3001/static/payment/alipay-qr-100.png
PAYMENT_ALIPAY_QR_URL_500=http://127.0.0.1:3001/static/payment/alipay-qr-500.png
PAYMENT_PAYEE_NAME=扫码收款
PAYMENT_SUPPORT_TEXT=扫码付款后点「我已付款」，积分立刻到账
PAYMENT_NOTICE=付款时可备注订单号，到账更快

# ---------------------------------------------------------------------------
# 邮箱验证码
# MAIL_PROVIDER=mock     本地：验证码打日志 / 接口返回 mockCode
# MAIL_PROVIDER=smtp     腾讯云 SES SMTP
# MAIL_PROVIDER=ses-api  腾讯云 SES 模板 API（SendEmail，推荐验证码）
# ---------------------------------------------------------------------------
MAIL_PROVIDER=mock
SMTP_HOST=smtp.qcloudmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_FROM_NAME=AI工作站
# ses-api：CAM 密钥 + 控制台「邮件模板」ID（变量：username / verify_code）
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_SES_REGION=ap-guangzhou
TENCENT_SES_OTP_TEMPLATE_ID=0
FEEDBACK_INBOX_EMAIL=jq202604@126.com
FEEDBACK_SMTP_HOST=smtp.126.com
FEEDBACK_SMTP_PORT=465
FEEDBACK_SMTP_SECURE=true
FEEDBACK_SMTP_USER=jq202604@126.com
FEEDBACK_SMTP_PASS=
FEEDBACK_SMTP_FROM=jq202604@126.com
EMAIL_OTP_TTL_SEC=300
EMAIL_OTP_RESEND_COOLDOWN_SEC=60
EMAIL_OTP_DAILY_LIMIT=10
